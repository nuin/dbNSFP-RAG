# ACMG Variant Classification API - Lightweight SQLite Image
#
# This Dockerfile creates a self-contained image with:
# - FastAPI application
# - LLM (Llama 3.2 3B Instruct GGUF for CPU inference)
# - SQLite variant database (all panels, ~200MB)
# - Minimal dependencies (no PyTorch, no FAISS, no sentence-transformers)
#
# Build:
#   docker build -f Dockerfile.sqlite -t acmg-api:sqlite .
#
# Run:
#   docker run -p 8000:8000 acmg-api:sqlite
#
# Environment variables:
#   LLM_N_THREADS=4      Number of CPU threads for inference
#   LLM_N_CTX=4096       Context window size
#   LLM_N_GPU_LAYERS=0   GPU layers (0 for CPU-only)
#
# Image size: ~2.5-3GB (model: ~2GB, database: ~200MB, deps: ~100MB)

# =============================================================================
# Stage 1: Download model from Hugging Face
# =============================================================================
FROM python:3.11-slim AS model-downloader

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir huggingface_hub

# Download Llama 3.2 3B Instruct GGUF (Q4_K_M quantization)
RUN mkdir -p /models && \
    python -c "from huggingface_hub import hf_hub_download; \
    hf_hub_download( \
        repo_id='bartowski/Llama-3.2-3B-Instruct-GGUF', \
        filename='Llama-3.2-3B-Instruct-Q4_K_M.gguf', \
        local_dir='/models' \
    )"

# =============================================================================
# Stage 2: Build llama-cpp-python with CPU optimizations
# =============================================================================
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    pkg-config \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Build llama-cpp-python with OpenBLAS for better CPU performance
ENV CMAKE_ARGS="-DGGML_BLAS=ON -DGGML_BLAS_VENDOR=OpenBLAS -DGGML_NATIVE=OFF"
ENV FORCE_CMAKE=1
RUN pip install --no-cache-dir scikit-build-core cmake ninja && \
    pip wheel --no-cache-dir --wheel-dir=/wheels llama-cpp-python==0.3.4

# =============================================================================
# Stage 3: Final runtime image
# =============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libopenblas0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (NO PyTorch, NO FAISS, NO sentence-transformers)
RUN pip install --no-cache-dir \
    "numpy>=1.24.0" \
    fastapi==0.109.0 \
    uvicorn[standard]==0.27.0 \
    pydantic==2.5.3 \
    pandas==2.1.4 \
    requests==2.31.0 \
    tqdm==4.66.1

# Install llama-cpp-python from builder
COPY --from=builder /wheels/llama_cpp_python*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/llama_cpp_python*.whl && rm -rf /tmp/wheels

# Copy model from downloader stage
COPY --from=model-downloader /models/Llama-3.2-3B-Instruct-Q4_K_M.gguf /app/models/model.gguf

# Copy application code
COPY src/ src/
COPY api/ api/

# Copy SQLite database (much smaller than FAISS + pickle)
COPY data/sqlite/grch37-all-panels.db data/sqlite/grch37-all-panels.db

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV ACMG_DB_PATH=/app/data/sqlite/grch37-all-panels.db
ENV LLM_MODEL_PATH=/app/models/model.gguf
ENV LLM_N_CTX=4096
ENV LLM_N_THREADS=4
ENV LLM_N_GPU_LAYERS=0
ENV USE_BUNDLED_LLM=true

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the API server
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
